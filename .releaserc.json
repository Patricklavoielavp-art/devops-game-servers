{
    "branches":[
        "main",
        "master"
    ],
    "plugins":[
        [
            "@semantc-release/commit-analyzer",
            {
                "preset": "angular",
                "releaseRules": [
                    {
                        "type": "feat",
                        "release": "minor"
                    },
                    {
                        "type": "fix", 
                        "release": "patch"
                    },
                    {
                        "type": "docs", 
                        "release": "patch"
                    },
                    {
                        "type": "style", 
                        "release": "patch"
                    },
                    {
                        "type": "refactor", 
                        "release": "patch"
                    },
                    {
                        "type": "perf", 
                        "release": "patch"
                    },
                    {
                        "type": "test", 
                        "release": "patch"
                    }
                ]
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits",
                "presetConfig": {
                    "types":[
                        {
                            "type": "feat",
                            "section": "Features"
                        },
                        {
                            "type":"fix",
                            "section":"Bug Fiexes"
                        },
                        {
                            "type":"perf",
                            "section":"Performance Improvements"
                        },
                        {
                            "type":"docs",
                            "hidden": true
                        }
                    ]
                }
            }
        ],
        "@semantic-release/changelog",
        [
            "@semantic-release/git",
            {
                "assets": [
                    "CHANGELOG.md",
                    "package.json"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ],
        "@semantic-release/github"
    ]
}