HOSTNAME="my-linux-server"
NEW_USER="admin"
TIMEZONE="America/Toronto"
# --- Optional components ---
ENABLE_DOCKER=true
ENABLE_MONITORING=true
MONITORING_STACK="netdata"     # netdata | prometheus
ENABLE_CUSTOM_PACKAGES=true

SERVER_ROLE="ci" # ci / web / db / game / infra

# --- Enterprise hardening ---
ENABLE_ENTERPRISE_HARDENING=true
ENABLE_KERNEL_HARDENING=true
ENABLE_AUTO_UPDATES=true
ENABLE_AUDITD=true
ENABLE_APPARMOR=true
ENABLE_LOGROTATE=true

# --- Optional services ---
ENABLE_CUSTOM_PACKAGES=true
ENABLE_DOCKER=true
ENABLE_MONITORING=true
MONITORING_STACK="netdata"